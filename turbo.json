{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "noUpdateNotifier": true,
  "cacheDir": ".turbo/cache",
  "remoteCache": {
    "signature": true
  },
  "globalDependencies": [".node-version", "tsconfig.base.json", "vitest.shared.ts"],
  "globalPassThroughEnv": ["TMPDIR", "TERM", "COLORTERM", "FORCE_COLOR", "NO_COLOR"],
  "tasks": {
    // No package has a `transit` script. Depending on it puts a package's workspace dependencies
    // (their source, through `^transit`) into a task's hash without building them: typecheck and
    // tests read workspace packages from source (the `@waypoint/source` export condition).
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "tsdown.config.ts", "package.json"],
      "outputs": ["dist/**"]
    },
    "smoke": {
      "dependsOn": ["build"],
      "inputs": ["scripts/smoke.ts", "package.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["transit", "//#typecheck:root"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "env": ["CI", "TURSODB_BIN", "UPDATE_CSP_HASHES"],
      "passThroughEnv": ["GITHUB_ACTIONS"],
      "outputs": []
    },
    // CPU-budget and wall-clock tests. `pnpm test` runs them after every `test` task, one
    // package at a time (`--concurrency=1`), so nothing else competes for the CPU.
    "test:timing": {
      "dependsOn": ["transit"],
      "env": ["CI", "TURSODB_BIN"],
      "passThroughEnv": ["GITHUB_ACTIONS"],
      "outputs": []
    },
    "test:browser": {
      "env": ["CHROME_PATH"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
      "outputs": []
    },
    "test:browser:reader": {
      "env": ["CHROME_PATH"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
      "outputs": []
    },
    "format:check": {
      "dependsOn": ["//#format:check:root"]
    },
    "lint": {
      "dependsOn": ["//#lint:root"]
    },
    "//#format:check:root": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    // One type-aware oxlint run over the whole repository, plus the core import guard. Types of
    // workspace packages come from source, so it needs no build.
    "//#lint:root": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!*.md",
        "!docs/**",
        "!deploy/*.md",
        "!.github/**",
        "!skills/**",
        "!**/Dockerfile",
        "!.dockerignore"
      ],
      "outputs": []
    },
    // Root scripts and the packages' build and test configs (tsconfig.json). The scripts import
    // writer source, so this follows every package's source like typecheck does.
    "//#typecheck:root": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!*.md",
        "!docs/**",
        "!deploy/*.md",
        "!.github/**",
        "!skills/**"
      ],
      "outputs": []
    }
  }
}
