{
  "name": "@waypoint/writer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:viewer": "node --conditions=@waypoint/source viewer.build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/client/tsconfig.json && tsc -p tests/tsconfig.json",
    "test": "vitest run --project unit",
    "test:timing": "vitest run --project timing",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@hono/node-server": "^2.1.3",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-oniguruma": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@smithy/node-http-handler": "^4.12.1",
    "@tursodatabase/database": "0.8.2",
    "@tursodatabase/sync": "0.8.2",
    "busboy": "^1.6.0",
    "diff": "^9.0.0",
    "hono": "^4.13.13",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "typeid-js": "^1.2.0",
    "unified": "11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.0.0",
    "@waypoint/core": "workspace:*",
    "@waypoint/render": "workspace:*",
    "@waypoint/ui": "workspace:*",
    "esbuild": "^0.28.2",
    "tsdown": "catalog:"
  }
}
