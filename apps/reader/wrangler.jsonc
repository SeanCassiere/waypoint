{
  // The generic default, for `wrangler dev` and the reader build (`pnpm build`: a dry-run bundle
  // into dist/). Deploys never use it as is: deploy/upgrade.sh renders a config for each reader
  // target in instance.env from this file (deploy/lib/reader-config.mjs). It takes the
  // compatibility settings, observability and binding names and limits from here, and the Worker
  // name, custom domain, Analytics Engine dataset and rate-limit namespace from the target.
  // workers.dev and Worker Previews stay off (docs/decisions.md D55).
  //
  // Secrets (wrangler secret bulk, from the target's secrets file): TURSO_DATABASE_URL,
  // TURSO_READONLY_TOKEN, R2_READER_ACCESS_KEY_ID, R2_READER_SECRET_ACCESS_KEY, R2_BUCKET,
  // RAW_CAP_KEY, R2_ACCOUNT_ID or WAYPOINT_S3_ENDPOINT, and optionally WAYPOINT_S3_REGION.
  "name": "waypoint-reader",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "observability": { "enabled": false },
  "workers_dev": false,
  "preview_urls": false,
  "analytics_engine_datasets": [{ "binding": "ACCESS_LOG", "dataset": "waypoint_access" }],
  "ratelimits": [
    {
      "name": "TOKEN_MISS_LIMITER",
      "namespace_id": "1000",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}
