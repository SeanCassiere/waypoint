{
  // Secrets per environment: TURSO_DATABASE_URL, TURSO_READONLY_TOKEN,
  // R2_ACCOUNT_ID, R2_READER_ACCESS_KEY_ID, R2_READER_SECRET_ACCESS_KEY, R2_BUCKET, RAW_CAP_KEY.
  "name": "waypoint-reader",
  "observability": { "enabled": false },
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": {
      "name": "waypoint-reader-dev",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "waypoint-dev.pingstash.com", "custom_domain": true }],
      "analytics_engine_datasets": [{ "binding": "ACCESS_LOG", "dataset": "waypoint_access_dev" }],
      "ratelimits": [
        {
          "name": "TOKEN_MISS_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
    "prod": {
      "name": "waypoint-reader",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "waypoint.pingstash.com", "custom_domain": true }],
      "analytics_engine_datasets": [{ "binding": "ACCESS_LOG", "dataset": "waypoint_access" }],
      "ratelimits": [
        {
          "name": "TOKEN_MISS_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
  },
}
