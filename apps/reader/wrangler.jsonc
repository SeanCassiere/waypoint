{
  // Secrets per environment: TURSO_DATABASE_URL, TURSO_READONLY_TOKEN,
  // R2_ACCOUNT_ID, R2_READER_ACCESS_KEY_ID, R2_READER_SECRET_ACCESS_KEY, R2_BUCKET, RAW_CAP_KEY.
  "name": "waypoint-reader",
  "observability": { "enabled": false },
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": {
      "name": "waypoint-reader-dev",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "waypoint-dev.pingstash.com", "custom_domain": true }],
      "analytics_engine_datasets": [{ "binding": "ACCESS_LOG", "dataset": "waypoint_access_dev" }],
      "ratelimits": [
        {
          "name": "TOKEN_MISS_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
    "prod": {
      "name": "waypoint-reader",
      // waypoint-reader.seancassiere.workers.dev, its version URLs and its Worker Previews
      // (pr-<n>-waypoint-reader.seancassiere.workers.dev) are all behind the Cloudflare Access app
      // fb19dcb4-9f87-47dc-a038-1b41cef93d0f (owner only). They're safe to enable only because of
      // it; see docs/decisions.md D49. The custom domain stays public and production only: never
      // set previews_enabled on it, and never put Access on it.
      "workers_dev": true,
      "preview_urls": true,
      "routes": [
        { "pattern": "waypoint.pingstash.com", "custom_domain": true, "previews_enabled": false },
      ],
      "analytics_engine_datasets": [{ "binding": "ACCESS_LOG", "dataset": "waypoint_access" }],
      "ratelimits": [
        {
          "name": "TOKEN_MISS_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      // Worker Previews (`wrangler preview --env prod`, deploy/preview-reader.sh) don't inherit
      // production bindings. They get their own Analytics Engine dataset and rate-limit
      // namespace, so preview traffic never mixes with production's. Their secrets are the prod
      // read-only reader values, uploaded with each preview deployment.
      "previews": {
        "analytics_engine_datasets": [
          { "binding": "ACCESS_LOG", "dataset": "waypoint_access_preview" },
        ],
        "ratelimits": [
          {
            "name": "TOKEN_MISS_LIMITER",
            "namespace_id": "1003",
            "simple": { "limit": 30, "period": 60 },
          },
        ],
      },
    },
  },
}
