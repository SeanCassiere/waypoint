{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "composite": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "lib": ["ES2024"],
    "rootDir": "."
  },
  "include": [
    "tests/**/*.ts",
    "packages/*/tests/**/*.ts",
    "apps/*/tests/**/*.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "vitest.config.ts",
    "packages/mcp/scripts/**/*.ts",
    "packages/mcp/esbuild.config.ts"
  ],
  "exclude": ["tests/fixtures/core-denied-import/**"]
}
