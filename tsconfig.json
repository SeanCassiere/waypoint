{
  "extends": "./tsconfig.base.json",
  // Root scripts, deploy/lib's generator and every package's build and test configs (*.config.ts, viewer.build.ts, the
  // MCP package scripts). Each package's own tsconfig.json files cover its source and tests.
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "lib": ["ES2024"]
  },
  "include": [
    "scripts/**/*.mjs",
    "deploy/**/*.mjs",
    "scripts/**/*.ts",
    "*.config.ts",
    "vitest.shared.ts",
    "packages/*/*.config.ts",
    "apps/*/*.config.ts",
    "tests/*.config.ts",
    "apps/writer/viewer.build.ts",
    "packages/mcp/scripts/**/*.ts"
  ]
}
