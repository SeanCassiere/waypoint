# Waypoint instance configuration, read by deploy/upgrade.sh (default location:
# ~/.config/waypoint/instance.env, or pass --instance FILE). deploy/make-instance-env.sh writes one
# from flags. Guide: docs/self-hosting.md.
#
# Format: literal KEY=value lines; # starts a comment line. Nothing is expanded or executed: no
# quotes, no $VARIABLES, no `~`. Unknown keys are an error. This file holds no secrets, only
# paths to the files that do; it must be owned by you and writable by no one else. Relative
# paths are relative to CONFIG_DIR.

# --- Writer -------------------------------------------------------------------------------------

# Where the env files below live. Default: the directory holding this file.
#CONFIG_DIR=/home/me/.config/waypoint

# The writer's data directory on the host (local DB, queue, blob cache). Required. It must be
# owned by WRITER_UID:WRITER_GID; upgrade.sh creates it when it's missing.
DATA_DIR=/home/me/.local/share/waypoint/prod

# The writer's env file (docs/configuration.md), mode 600. Required. It must set WAYPOINT_ENV.
WRITER_ENV_FILE=writer.env

# The writer image, without a tag: a release deploys <IMAGE>:<version>, pinned by digest.
#IMAGE=ghcr.io/seancassiere/waypoint-writer

# GitHub repository whose releases `upgrade.sh latest` and `upgrade.sh <version>` fetch. Default:
# derived from a ghcr.io/<owner>/waypoint-writer IMAGE as <owner>/waypoint.
#RELEASE_REPO=owner/waypoint

# Docker Compose project name. Containers are <project>-writer-1 (and <project>-ts-waypoint-1);
# the Tailscale state volume is <project>_tailscale-state. Default: waypoint.
#COMPOSE_PROJECT=waypoint

# Where upgrade.sh keeps what each component runs and its lock. Default: state/<project>.
#STATE_DIR=state/waypoint

# An extra Compose file layered last, for your own changes (resource limits, labels, ...).
# Compose resolves relative paths inside it (bind mounts, env_file) against the directory of
# deploy/compose.yaml, not this file's: use absolute paths there.
#COMPOSE_OVERRIDE=compose.override.yaml

# The uid and gid the writer runs as, which own DATA_DIR. Default: 1000.
#WRITER_UID=1000
#WRITER_GID=1000

# Without Tailscale, the writer is published on this host address and port. The writer has no
# login: keep it on loopback unless the network in front of it is trusted. If the port isn't
# 7410, set WAYPOINT_BASE_URL in the writer env file to the URL you open. Defaults: 127.0.0.1, 7410.
#WRITER_BIND_ADDRESS=127.0.0.1
#WRITER_HOST_PORT=7410

# A URL that must answer the new writer's /healthz before a deploy counts as done, as clients
# reach it: for example https://waypoint.<tailnet>.ts.net/healthz. Optional; without it only the
# container's own health check gates the deploy.
#WRITER_HEALTH_URL=https://waypoint.example.ts.net/healthz

# --- Tailscale (optional) ------------------------------------------------------------------------

# on: run the writer behind its own Tailscale node (compose.tailscale.yaml), with no host port.
# Default: off.
#TAILSCALE=on

# Env file holding TS_AUTHKEY, mode 600. Used only for the node's first login. Default: ts.env.
#TAILSCALE_ENV_FILE=ts.env

# The node's name, so the writer is https://<name>.<tailnet>.ts.net. Default: waypoint.
#TAILSCALE_HOSTNAME=waypoint

# Tags the node advertises, comma-separated. Default: none.
#TAILSCALE_TAGS=tag:waypoint

# --- Public readers (optional) -------------------------------------------------------------------

# Cloudflare deploy credentials (CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN), mode 600. Needed
# only with reader targets. Default: cloudflare.env. This file and the reader secrets files use
# the same KEY=value format, but their values may contain quotes, $ and backticks, all taken
# literally; don't wrap a value in quotes.
#CLOUDFLARE_ENV_FILE=cloudflare.env

# Reader targets, deployed in this order after the writer. Names are lowercase letters and
# digits. Each target <t> needs the READER_<t>_* keys below. Default: none.
#READER_TARGETS=prod

# The Worker's name.
#READER_prod_WORKER=waypoint-reader
# Its custom domain. Wrangler attaches it (the zone must be on the same Cloudflare account).
#READER_prod_DOMAIN=share.example.com
# The reader's secrets (docs/configuration.md#public-reader-cloudflare-worker), mode 600.
#READER_prod_SECRETS_FILE=reader-prod.env
# Analytics Engine dataset for the access log (created on first write).
#READER_prod_ANALYTICS_DATASET=waypoint_access
# Rate-limit namespace ID: any integer, unique per Worker on the account.
#READER_prod_RATELIMIT_NAMESPACE=1001
# Serve the Worker on its workers.dev hostname too. Default: false.
#READER_prod_WORKERS_DEV=false
