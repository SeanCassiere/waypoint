{
  "name": "waypoint",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run format:check lint typecheck && pnpm notices:check && pnpm test",
    "format": "oxfmt --write .",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:timing",
    "test:timing": "turbo run test:timing --concurrency=1",
    "test:browser": "turbo run test:browser",
    "test:browser:reader": "turbo run test:browser:reader",
    "demo": "tsx --tsconfig apps/writer/tsconfig.json --conditions=@waypoint/source scripts/demo-writer.ts",
    "demo:reader": "tsx --tsconfig apps/reader/tsconfig.json --conditions=@waypoint/source scripts/demo-reader.ts",
    "snapshot:pages": "tsx --tsconfig apps/writer/tsconfig.json --conditions=@waypoint/source scripts/snapshot-pages.ts",
    "live-smoke": "tsx --tsconfig apps/writer/tsconfig.json --conditions=@waypoint/source scripts/live-smoke.ts",
    "core:guard": "node scripts/check-core-imports.mjs",
    "notices": "node scripts/third-party-notices.ts",
    "notices:check": "node scripts/third-party-notices.ts --check",
    "format:check:root": "oxfmt --check .",
    "lint:root": "oxlint . && pnpm core:guard",
    "typecheck:root": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "turbo": "2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.2"
}
