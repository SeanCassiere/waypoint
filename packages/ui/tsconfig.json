{
  "extends": "../../tsconfig.base.json",
  // The library source. isolatedDeclarations lets tsdown generate the .d.ts with oxc, and
  // erasableSyntaxOnly keeps the source runnable by Node (worker threads started from source).
  "compilerOptions": {
    "declaration": true,
    "isolatedDeclarations": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2024", "WebWorker"],
    "types": []
  },
  "include": ["src"]
}
